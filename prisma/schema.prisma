generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_EMAIL_VERIFY
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR
  EMPLOYEE
  USER
  admin
  hr
  employee
  user
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  firstName String?
  lastName  String?
  name      String?

  email    String @unique
  password String?

  authProvider AuthProvider @default(EMAIL)
  providerId   String?

  emailVerified  Boolean   @default(false)
  emailOtp       String?
  emailOtpExpiry DateTime?

  resetToken       String?
  resetTokenExpiry DateTime?

  role   UserRole   @default(USER)
  status UserStatus @default(PENDING_EMAIL_VERIFY)

  loginAttempts Int       @default(0)
  lockedUntil   DateTime?

  phone  String?
  avatar String?

  lastLoginAt DateTime?
  lastSeenAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobApplication {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String @unique
  phone       String?
  coverLetter String?
  resumeUrl   String?
  linkedin    String?
  portfolio   String?
  jobTitle    String
  status      String @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String
  phone       String?
  coverLetter String?
  resumeUrl   String?
  linkedin    String?
  portfolio   String?
  status      String @default("pending")
  jobTitle    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeamMember {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  slug               String   @unique
  name               String
  role               String
  initials           String
  avatarColor        String
  bio                String?
  image              String?
  location           String?
  experience         String?
  email              String?
  linkedin           String?
  twitter            String?
  github             String?
  team               String
  order              Int      @default(0)
  expertise          String[] @default([])
  skills             String[] @default([])
  experienceTimeline Json?
  education          Json?
  projects           Json?
  certifications     String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model BlogPost {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  slug        String        @unique
  title       String
  excerpt     String
  content     String?
  author      String
  category    String
  tags        String[]      @default([])
  image       String?
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Project {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  slug        String        @unique
  title       String
  description String
  category    String
  tags        String[]      @default([])
  image       String?
  stack       String[]      @default([])
  link        String?
  status      PublishStatus @default(DRAFT)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Testimonial {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String
  company   String?
  content   String
  avatar    String?
  rating    Int    @default(5)
  featured  Boolean @default(false)
  order     Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  slug        String @unique
  name        String
  description String
  icon        String
  color       String
  features    String[] @default([])
  techStack   String[] @default([])
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JobOpening {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  slug         String        @unique
  title        String
  department   String
  location     String
  type         String
  salary       String?
  description  String
  requirements String[]        @default([])
  benefits     String[]        @default([])
  status       PublishStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Faq {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  question String
  answer   String
  category String @default("general")
  order    Int    @default(0)
  active   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Technology {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String @unique
  icon        String
  category    String
  description String?
  order       Int    @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProcessStep {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  step        String
  title       String
  description String
  icon        String
  page        String
  order       Int    @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Perk {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  icon        String
  order       Int    @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanyValue {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  icon        String
  order       Int    @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteStat {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  label     String
  value     String
  icon      String
  section   String
  order     Int    @default(0)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  email     String @unique
  name      String?
  status    String @default("active")
  source    String @default("website")
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  entity    String
  entityId  String?
  userId    String?
  userName  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model SeoSetting {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  page        String @unique
  title       String?
  description String?
  keywords    String[] @default([])
  ogImage     String?
  canonical   String?
  noIndex     Boolean @default(false)
  schemaJson  String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model WebsiteSetting {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  key       String @unique
  value     String
  group     String @default("general")
  label     String?
  type      String @default("text")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Backup {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  filePath  String
  fileSize  Int    @default(0)
  status    String @default("completed")
  createdAt DateTime @default(now())
}

model PricingPlan {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  price       String
  sub         String?
  description String
  features    String[] @default([])
  cta         String
  featured    Boolean  @default(false)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
