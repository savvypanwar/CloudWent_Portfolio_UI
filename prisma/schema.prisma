generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_EMAIL_VERIFY
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR
  EMPLOYEE
  USER
  admin
  hr
  employee
  user
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Basic Info
  firstName String?
  lastName  String?
  name       String?

  // Authentication
  email    String @unique
  password String?

  authProvider AuthProvider @default(EMAIL)
  providerId   String?

  // Verification
  emailVerified Boolean  @default(false)
  emailOtp      String?
  emailOtpExpiry DateTime?

  // Password Reset
  resetToken       String?
  resetTokenExpiry DateTime?

  // Security
  role   UserRole   @default(USER)
  status UserStatus @default(PENDING_EMAIL_VERIFY)

  loginAttempts Int @default(0)
  lockedUntil   DateTime?

  // Profile
  phone      String?
  avatar     String?


  // Last Activity
  lastLoginAt DateTime?
  lastSeenAt  DateTime?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model JobApplication {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  email String @unique
  phone String?
  coverLetter String?
  resumeUrl String?
  linkedin String?
  portfolio String?
  jobTitle String
  status String @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  email String @unique
  subject String
  message String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  email String @unique
  phone String?
  coverLetter String?
  resumeUrl String?
  linkedin String?
  portfolio String?
  status String @default("pending")
  jobTitle String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  slug               String   @unique
  name               String
  role               String
  initials           String
  avatarColor        String
  bio                String?
  location           String?
  experience         String?
  email              String?
  linkedin           String?
  twitter            String?
  github             String?
  team               String
  order              Int      @default(0)
  image              String?
  expertise          String[] @default([])
  skills             String[] @default([])
  experienceTimeline Json?
  education          Json?
  projects           Json?
  certifications     String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
